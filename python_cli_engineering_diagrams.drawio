<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net">
  <diagram id="cli-1" name="系統架構">
    <mxGraphModel dx="900" dy="550" page="1" pageWidth="1000" pageHeight="500" grid="1" gridSize="10">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" vertex="1" value="系統架構" style="text;align=left;fontSize=22;fontStyle=1;">
          <mxGeometry x="40" y="30" width="500" height="50" as="geometry" />
        </mxCell>
        <mxCell id="n1" parent="1" vertex="1" value="命令入口｜argv 和 argparse" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf3fc;strokeColor=#6294bb;fontSize=15;spacing=10;">
          <mxGeometry x="40" y="115" width="195" height="75" as="geometry" />
        </mxCell>
        <mxCell id="n2" parent="1" vertex="1" value="設定與驗證｜來源、型別與範圍" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf3fc;strokeColor=#6294bb;fontSize=15;spacing=10;">
          <mxGeometry x="265" y="115" width="195" height="75" as="geometry" />
        </mxCell>
        <mxCell id="n3" parent="1" vertex="1" value="應用層｜plan / apply / report" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf3fc;strokeColor=#6294bb;fontSize=15;spacing=10;">
          <mxGeometry x="490" y="115" width="195" height="75" as="geometry" />
        </mxCell>
        <mxCell id="n4" parent="1" vertex="1" value="輸出層｜JSON、stderr、退出碼" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf3fc;strokeColor=#6294bb;fontSize=15;spacing=10;">
          <mxGeometry x="715" y="115" width="195" height="75" as="geometry" />
        </mxCell>
        <mxCell id="e1" parent="1" edge="1" source="n1" target="n2" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;strokeColor=#376a94;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" parent="1" edge="1" source="n2" target="n3" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;strokeColor=#376a94;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" parent="1" edge="1" source="n3" target="n4" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;strokeColor=#376a94;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="cli-2" name="執行流程">
    <mxGraphModel dx="900" dy="550" page="1" pageWidth="1000" pageHeight="500" grid="1" gridSize="10">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" vertex="1" value="執行流程" style="text;align=left;fontSize=22;fontStyle=1;">
          <mxGeometry x="40" y="30" width="500" height="50" as="geometry" />
        </mxCell>
        <mxCell id="n1" parent="1" vertex="1" value="解析並驗證｜錯誤退出 2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf3fc;strokeColor=#6294bb;fontSize=15;spacing=10;">
          <mxGeometry x="40" y="115" width="195" height="75" as="geometry" />
        </mxCell>
        <mxCell id="n2" parent="1" vertex="1" value="選擇模式｜預檢不寫入" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf3fc;strokeColor=#6294bb;fontSize=15;spacing=10;">
          <mxGeometry x="265" y="115" width="195" height="75" as="geometry" />
        </mxCell>
        <mxCell id="n3" parent="1" vertex="1" value="執行或讀回｜真寫入採暫存換檔" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf3fc;strokeColor=#6294bb;fontSize=15;spacing=10;">
          <mxGeometry x="490" y="115" width="195" height="75" as="geometry" />
        </mxCell>
        <mxCell id="n4" parent="1" vertex="1" value="結束｜成功 0、I/O 失敗 3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf3fc;strokeColor=#6294bb;fontSize=15;spacing=10;">
          <mxGeometry x="715" y="115" width="195" height="75" as="geometry" />
        </mxCell>
        <mxCell id="e1" parent="1" edge="1" source="n1" target="n2" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;strokeColor=#376a94;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" parent="1" edge="1" source="n2" target="n3" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;strokeColor=#376a94;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" parent="1" edge="1" source="n3" target="n4" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;strokeColor=#376a94;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>