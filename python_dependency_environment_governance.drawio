<mxfile host="app.diagrams.net" version="24.7.8"><diagram id="arch" name="依賴交付架構"><mxGraphModel grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1140" pageHeight="640"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="node0" value="輸入宣告&#10;專案直接依賴、Python 範圍、build backend 與環境 marker。" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8f3ff;strokeColor=#6f9ab7;fontSize=16;spacing=10;align=center;"><mxGeometry x="55" y="145" width="172" height="155" as="geometry" /></mxCell><mxCell id="node1" value="解析與固定&#10;在明確目標環境求解 transitive closure，審查版本、來源與雜湊。" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8f3ff;strokeColor=#6f9ab7;fontSize=16;spacing=10;align=center;"><mxGeometry x="262" y="145" width="172" height="155" as="geometry" /></mxCell><mxCell id="e1" edge="1" parent="1" source="node0" target="node1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;strokeColor=#376689;strokeWidth=2;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="node2" value="受控成品&#10;只保留目標 ABI／平台可用 wheels、清單與可信摘要。" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8f3ff;strokeColor=#6f9ab7;fontSize=16;spacing=10;align=center;"><mxGeometry x="469" y="145" width="172" height="155" as="geometry" /></mxCell><mxCell id="e2" edge="1" parent="1" source="node1" target="node2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;strokeColor=#376689;strokeWidth=2;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="node3" value="驗收與保存&#10;乾淨 venv 離線安裝、pip check、入口測試與報告；保留回退包。" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8f3ff;strokeColor=#6f9ab7;fontSize=16;spacing=10;align=center;"><mxGeometry x="676" y="145" width="172" height="155" as="geometry" /></mxCell><mxCell id="e3" edge="1" parent="1" source="node2" target="node3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;strokeColor=#376689;strokeWidth=2;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="note" value="產物或證據不符 → 停止本次部署；復用已核准的上一版本環境、鎖檔及 wheel。" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffefd7;strokeColor=#6f9ab7;fontSize=16;spacing=10;align=center;"><mxGeometry x="60" y="390" width="995" height="70" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="flow" name="驗收與回退流程"><mxGraphModel grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1140" pageHeight="640"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="node0" value="設定目標&#10;Python 小版本、實作、OS、架構與 runtime image。" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8f3ff;strokeColor=#6f9ab7;fontSize=16;spacing=10;align=center;"><mxGeometry x="55" y="145" width="172" height="155" as="geometry" /></mxCell><mxCell id="node1" value="更新鎖定&#10;在受控建置端解析；以目標矩陣分別核准差異。" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8f3ff;strokeColor=#6f9ab7;fontSize=16;spacing=10;align=center;"><mxGeometry x="262" y="145" width="172" height="155" as="geometry" /></mxCell><mxCell id="e1" edge="1" parent="1" source="node0" target="node1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;strokeColor=#376689;strokeWidth=2;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="node2" value="準備成品&#10;下載或建置選定 wheels；留鎖檔和摘要。" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8f3ff;strokeColor=#6f9ab7;fontSize=16;spacing=10;align=center;"><mxGeometry x="469" y="145" width="172" height="155" as="geometry" /></mxCell><mxCell id="e2" edge="1" parent="1" source="node1" target="node2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;strokeColor=#376689;strokeWidth=2;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="node3" value="隔離驗收&#10;離線驗雜湊並安裝，測 API／CLI、必要的 ABI 匯入。" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8f3ff;strokeColor=#6f9ab7;fontSize=16;spacing=10;align=center;"><mxGeometry x="676" y="145" width="172" height="155" as="geometry" /></mxCell><mxCell id="e3" edge="1" parent="1" source="node2" target="node3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;strokeColor=#376689;strokeWidth=2;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="node4" value="核准或回退&#10;證據不符停止；改用已核准舊成品組合，不現場重解。" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8f3ff;strokeColor=#6f9ab7;fontSize=16;spacing=10;align=center;"><mxGeometry x="883" y="145" width="172" height="155" as="geometry" /></mxCell><mxCell id="e4" edge="1" parent="1" source="node3" target="node4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;strokeColor=#376689;strokeWidth=2;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="note" value="產物或證據不符 → 停止本次部署；復用已核准的上一版本環境、鎖檔及 wheel。" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffefd7;strokeColor=#6f9ab7;fontSize=16;spacing=10;align=center;"><mxGeometry x="60" y="390" width="995" height="70" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>