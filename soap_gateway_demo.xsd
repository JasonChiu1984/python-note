<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
  targetNamespace="urn:teaching:gateway:v1" elementFormDefault="qualified">
  <xs:element name="ReadPoint">
    <xs:complexType><xs:sequence>
      <xs:element name="pointId" type="xs:string"/>
    </xs:sequence></xs:complexType>
  </xs:element>
  <xs:element name="ReadPointResponse">
    <xs:complexType><xs:sequence>
      <xs:element name="value">
        <xs:simpleType><xs:restriction base="xs:decimal">
          <xs:minInclusive value="-50"/><xs:maxInclusive value="150"/>
        </xs:restriction></xs:simpleType>
      </xs:element>
      <xs:element name="unit" type="xs:string" fixed="degC"/>
    </xs:sequence></xs:complexType>
  </xs:element>
</xs:schema>
