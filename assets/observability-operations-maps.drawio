<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net">
  <diagram id="architecture" name="架構：可觀測性與維運責任">
    <mxGraphModel page="1" pageWidth="1000" pageHeight="930" grid="1">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;b&gt;架構：可觀測性與維運責任&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;spacing=10;fontSize=15;fillColor=#dcebf5;strokeColor=#4a6b85;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="200" y="20" width="600" height="54" />
        </mxCell>
        <mxCell id="m0" value="&lt;b&gt;01 · 服務與外側探測&lt;/b&gt;&lt;br&gt;API／工作者／資料閘道插樁；外側探測驗證真實結果" style="rounded=1;whiteSpace=wrap;html=1;spacing=10;fontSize=15;fillColor=#f4faf8;strokeColor=#2d8a69;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="235" y="100" width="530" height="78" />
        </mxCell>
        <mxCell id="m1" value="&lt;b&gt;02 · 遙測採集&lt;/b&gt;&lt;br&gt;獨立生產 Logs、Metrics、Traces；限定佇列、匯出重試" style="rounded=1;whiteSpace=wrap;html=1;spacing=10;fontSize=15;fillColor=#f4faf8;strokeColor=#2d8a69;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="235" y="215" width="530" height="78" />
        </mxCell>
        <mxCell id="p1" value="" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;rounded=0;html=1;labelBackgroundColor=#ffffff;strokeColor=#536c82;" edge="1" parent="1" source="m0" target="m1">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="m2" value="&lt;b&gt;03 · 儲存與查詢&lt;/b&gt;&lt;br&gt;各訊號進對應後端；用服務、版本、時間和關聯鍵串讀" style="rounded=1;whiteSpace=wrap;html=1;spacing=10;fontSize=15;fillColor=#f4faf8;strokeColor=#2d8a69;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="235" y="330" width="530" height="78" />
        </mxCell>
        <mxCell id="p2" value="" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;rounded=0;html=1;labelBackgroundColor=#ffffff;strokeColor=#536c82;" edge="1" parent="1" source="m1" target="m2">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="m3" value="&lt;b&gt;04 · 判斷與通知&lt;/b&gt;&lt;br&gt;用合格及壞事件算 SLI；規則分級、分組、路由與升級" style="rounded=1;whiteSpace=wrap;html=1;spacing=10;fontSize=15;fillColor=#f4faf8;strokeColor=#2d8a69;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="235" y="445" width="530" height="78" />
        </mxCell>
        <mxCell id="p3" value="" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;rounded=0;html=1;labelBackgroundColor=#ffffff;strokeColor=#536c82;" edge="1" parent="1" source="m2" target="m3">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="m4" value="&lt;b&gt;05 · 值班與回復&lt;/b&gt;&lt;br&gt;確認影響，依 runbook 止血；分段復原並重驗" style="rounded=1;whiteSpace=wrap;html=1;spacing=10;fontSize=15;fillColor=#f4faf8;strokeColor=#2d8a69;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="235" y="560" width="530" height="78" />
        </mxCell>
        <mxCell id="p4" value="" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;rounded=0;html=1;labelBackgroundColor=#ffffff;strokeColor=#536c82;" edge="1" parent="1" source="m3" target="m4">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="b0" value="&lt;b&gt;獨立健康護欄&lt;/b&gt;&lt;br&gt;檢測採集、規則和通知的失聯；告警失聯不算健康。" style="rounded=1;whiteSpace=wrap;html=1;spacing=10;fontSize=15;fillColor=#eff4f8;strokeColor=#4a6b85;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="160" y="740" width="330" height="100" />
        </mxCell>
        <mxCell id="d0" value="" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;rounded=0;html=1;labelBackgroundColor=#ffffff;strokeColor=#536c82;dashed=1;exitX=0;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="m1" target="b0">
          <mxGeometry as="geometry" relative="1">
            <Array as="points">
              <mxPoint x="120" y="254" />
              <mxPoint x="120" y="702" />
              <mxPoint x="325" y="702" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="b1" value="&lt;b&gt;跨層契約&lt;/b&gt;&lt;br&gt;保留版本、資料來源時間、觀察時間；遮蔽機密與個資。" style="rounded=1;whiteSpace=wrap;html=1;spacing=10;fontSize=15;fillColor=#eff4f8;strokeColor=#4a6b85;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="510" y="740" width="330" height="100" />
        </mxCell>
        <mxCell id="d1" value="" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;rounded=0;html=1;labelBackgroundColor=#ffffff;strokeColor=#536c82;dashed=1;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="m2" target="b1">
          <mxGeometry as="geometry" relative="1">
            <Array as="points">
              <mxPoint x="890" y="369" />
              <mxPoint x="890" y="790" />
            </Array>
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="flow" name="流程：發現、止血、復原與驗收">
    <mxGraphModel page="1" pageWidth="1000" pageHeight="930" grid="1">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;b&gt;流程：發現、止血、復原與驗收&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;spacing=10;fontSize=15;fillColor=#dcebf5;strokeColor=#4a6b85;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="200" y="20" width="600" height="54" />
        </mxCell>
        <mxCell id="m0" value="&lt;b&gt;01 · 發現並回應&lt;/b&gt;&lt;br&gt;從使用者症狀或主動探測開事故、確認值班與範圍。" style="rounded=1;whiteSpace=wrap;html=1;spacing=10;fontSize=15;fillColor=#f4faf8;strokeColor=#2d8a69;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="235" y="100" width="530" height="78" />
        </mxCell>
        <mxCell id="m1" value="&lt;b&gt;02 · 找出責任區段&lt;/b&gt;&lt;br&gt;查 SLI、版本及依賴，以關聯 log／trace 佐證，不靠猜測。" style="rounded=1;whiteSpace=wrap;html=1;spacing=10;fontSize=15;fillColor=#f4faf8;strokeColor=#2d8a69;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="235" y="215" width="530" height="78" />
        </mxCell>
        <mxCell id="p1" value="" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;rounded=0;html=1;labelBackgroundColor=#ffffff;strokeColor=#536c82;" edge="1" parent="1" source="m0" target="m1">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="m2" value="&lt;b&gt;03 · 有限止血與復原&lt;/b&gt;&lt;br&gt;選可逆降級、停止推出新版；依批准的 runbook 復原資料與服務。" style="rounded=1;whiteSpace=wrap;html=1;spacing=10;fontSize=15;fillColor=#f4faf8;strokeColor=#2d8a69;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="235" y="330" width="530" height="78" />
        </mxCell>
        <mxCell id="p2" value="" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;rounded=0;html=1;labelBackgroundColor=#ffffff;strokeColor=#536c82;" edge="1" parent="1" source="m1" target="m2">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="m3" value="&lt;b&gt;04 · 驗收閘門&lt;/b&gt;&lt;br&gt;用外側探測、SLO、資料新鮮度和對帳驗證，再決定是否擴量。" style="rounded=1;whiteSpace=wrap;html=1;spacing=10;fontSize=15;fillColor=#f4faf8;strokeColor=#2d8a69;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="235" y="445" width="530" height="78" />
        </mxCell>
        <mxCell id="p3" value="" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;rounded=0;html=1;labelBackgroundColor=#ffffff;strokeColor=#536c82;" edge="1" parent="1" source="m2" target="m3">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="b0" value="&lt;b&gt;驗收通過&lt;/b&gt;&lt;br&gt;分段擴量並保留觀察窗；關閉事故、安排復盤。" style="rounded=1;whiteSpace=wrap;html=1;spacing=10;fontSize=15;fillColor=#fff5db;strokeColor=#a97525;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="220" y="660" width="260" height="105" />
        </mxCell>
        <mxCell id="d0" value="" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;rounded=0;html=1;labelBackgroundColor=#ffffff;strokeColor=#536c82;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="m3" target="b0">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="b1" value="&lt;b&gt;驗收未通過&lt;/b&gt;&lt;br&gt;停止擴量，回到定位與止血；保留本輪證據。" style="rounded=1;whiteSpace=wrap;html=1;spacing=10;fontSize=15;fillColor=#fff5db;strokeColor=#a97525;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="520" y="660" width="260" height="105" />
        </mxCell>
        <mxCell id="d1" value="" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;rounded=0;html=1;labelBackgroundColor=#ffffff;strokeColor=#536c82;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="m3" target="b1">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="return" value="未達門檻則重新定位" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;rounded=0;html=1;labelBackgroundColor=#ffffff;strokeColor=#536c82;dashed=1;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="b1" target="m1">
          <mxGeometry as="geometry" relative="1">
            <Array as="points">
              <mxPoint x="650" y="820" />
              <mxPoint x="65" y="820" />
              <mxPoint x="65" y="254" />
            </Array>
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>