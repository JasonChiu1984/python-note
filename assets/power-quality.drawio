<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net">
  <diagram id="pq-architecture" name="電力品質資料架構">
    <mxGraphModel page="1" pageWidth="1200" pageHeight="460" adaptiveColors="auto">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="n0" parent="1" vertex="1" value="&lt;b&gt;01 選定量測點&lt;/b&gt;&lt;br&gt;公用電網共同耦合點（PCC）、負載端或配電分盤；記錄相序與額定電壓。" style="rounded=1;whiteSpace=wrap;html=1;spacing=14;fillColor=#edf5ff;strokeColor=#c7daee;fontSize=16;">
          <mxGeometry as="geometry" x="40" y="90" width="235" height="145" />
        </mxCell>
        <mxCell id="n1" parent="1" vertex="1" value="&lt;b&gt;02 接收並驗證&lt;/b&gt;&lt;br&gt;匯出原始波形、諧波檔與事件；保留比例、時間基準、儀表設定及缺值旗標。" style="rounded=1;whiteSpace=wrap;html=1;spacing=14;fillColor=#edf5ff;strokeColor=#c7daee;fontSize=16;">
          <mxGeometry as="geometry" x="320" y="90" width="235" height="145" />
        </mxCell>
        <mxCell id="e1" parent="1" edge="1" source="n0" target="n1" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=1;strokeColor=#246fa4;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="n2" parent="1" vertex="1" value="&lt;b&gt;03 分流計算&lt;/b&gt;&lt;br&gt;穩態窗算 PF、諧波與相序；事件窗另算暫降、暫升及持續時間。" style="rounded=1;whiteSpace=wrap;html=1;spacing=14;fillColor=#edf5ff;strokeColor=#c7daee;fontSize=16;">
          <mxGeometry as="geometry" x="600" y="90" width="235" height="145" />
        </mxCell>
        <mxCell id="e2" parent="1" edge="1" source="n1" target="n2" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=1;strokeColor=#246fa4;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="n3" parent="1" vertex="1" value="&lt;b&gt;04 保存證據&lt;/b&gt;&lt;br&gt;報表帶原檔、算式版本、分母、窗長與適用條款；缺資料就標示不可判定。" style="rounded=1;whiteSpace=wrap;html=1;spacing=14;fillColor=#edf5ff;strokeColor=#c7daee;fontSize=16;">
          <mxGeometry as="geometry" x="880" y="90" width="235" height="145" />
        </mxCell>
        <mxCell id="e3" parent="1" edge="1" source="n2" target="n3" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=1;strokeColor=#246fa4;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="pq-flow" name="電力品質判讀流程">
    <mxGraphModel page="1" pageWidth="1200" pageHeight="460" adaptiveColors="auto">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="n0" parent="1" vertex="1" value="&lt;b&gt;01 檢查資料品質&lt;/b&gt;&lt;br&gt;相序、窗長、時間同步、遺漏、裁切，任一不明先標記。" style="rounded=1;whiteSpace=wrap;html=1;spacing=14;fillColor=#edf5ff;strokeColor=#c7daee;fontSize=16;">
          <mxGeometry as="geometry" x="40" y="90" width="235" height="145" />
        </mxCell>
        <mxCell id="n1" parent="1" vertex="1" value="&lt;b&gt;02 選時間窗&lt;/b&gt;&lt;br&gt;例：60 Hz 的 12 週波為 200 ms。暫降用逐半週更新的一週波 RMS，不能用 200 ms 或十分鐘平均代替。" style="rounded=1;whiteSpace=wrap;html=1;spacing=14;fillColor=#edf5ff;strokeColor=#c7daee;fontSize=16;">
          <mxGeometry as="geometry" x="320" y="90" width="235" height="145" />
        </mxCell>
        <mxCell id="e1" parent="1" edge="1" source="n0" target="n1" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=1;strokeColor=#246fa4;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="n2" parent="1" vertex="1" value="&lt;b&gt;03 計算並比對&lt;/b&gt;&lt;br&gt;先用相同位置與窗對齊波形及事件。穩態彙整和合規判讀分開。" style="rounded=1;whiteSpace=wrap;html=1;spacing=14;fillColor=#edf5ff;strokeColor=#c7daee;fontSize=16;">
          <mxGeometry as="geometry" x="600" y="90" width="235" height="145" />
        </mxCell>
        <mxCell id="e2" parent="1" edge="1" source="n1" target="n2" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=1;strokeColor=#246fa4;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="n3" parent="1" vertex="1" value="&lt;b&gt;04 驗證因果&lt;/b&gt;&lt;br&gt;交叉比對上游與下游、變頻器負載及設備事件；同時出現不代表同一原因。" style="rounded=1;whiteSpace=wrap;html=1;spacing=14;fillColor=#edf5ff;strokeColor=#c7daee;fontSize=16;">
          <mxGeometry as="geometry" x="880" y="90" width="235" height="145" />
        </mxCell>
        <mxCell id="e3" parent="1" edge="1" source="n2" target="n3" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=1;strokeColor=#246fa4;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>