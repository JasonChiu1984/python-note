<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net">
  <diagram id="architecture" name="架構：外部整合責任邊界">
    <mxGraphModel page="1" pageWidth="1000" pageHeight="930" grid="1">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;b&gt;架構：外部整合責任邊界&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;spacing=10;fontSize=15;fillColor=#dcebf5;strokeColor=#4a6b85;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="200" y="20" width="600" height="54" />
        </mxCell>
        <mxCell id="m0" value="&lt;b&gt;01 · 業務／入口&lt;/b&gt;&lt;br&gt;讀取快照、執行作業、接收事件；定義新鮮度和完成條件" style="rounded=1;whiteSpace=wrap;html=1;spacing=10;fontSize=15;fillColor=#f4faf8;strokeColor=#2d8a69;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="235" y="100" width="530" height="78" />
        </mxCell>
        <mxCell id="m1" value="&lt;b&gt;02 · 應用配接器&lt;/b&gt;&lt;br&gt;轉換資料與錯誤；為寫入建操作 ID；狀態不明轉對帳" style="rounded=1;whiteSpace=wrap;html=1;spacing=10;fontSize=15;fillColor=#f4faf8;strokeColor=#2d8a69;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="235" y="215" width="530" height="78" />
        </mxCell>
        <mxCell id="p1" value="" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;rounded=0;html=1;labelBackgroundColor=#ffffff;strokeColor=#536c82;" edge="1" parent="1" source="m0" target="m1">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="m2" value="&lt;b&gt;03 · 韌性策略&lt;/b&gt;&lt;br&gt;總期限；令牌、佇列、併發；斷路、挑選重試" style="rounded=1;whiteSpace=wrap;html=1;spacing=10;fontSize=15;fillColor=#f4faf8;strokeColor=#2d8a69;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="235" y="330" width="530" height="78" />
        </mxCell>
        <mxCell id="p2" value="" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;rounded=0;html=1;labelBackgroundColor=#ffffff;strokeColor=#536c82;" edge="1" parent="1" source="m1" target="m2">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="m3" value="&lt;b&gt;04 · 傳輸配接器&lt;/b&gt;&lt;br&gt;HTTP／RPC 池、驗證、傳輸與取消；可替換成 fake" style="rounded=1;whiteSpace=wrap;html=1;spacing=10;fontSize=15;fillColor=#f4faf8;strokeColor=#2d8a69;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="235" y="445" width="530" height="78" />
        </mxCell>
        <mxCell id="p3" value="" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;rounded=0;html=1;labelBackgroundColor=#ffffff;strokeColor=#536c82;" edge="1" parent="1" source="m2" target="m3">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="m4" value="&lt;b&gt;05 · 外部依賴&lt;/b&gt;&lt;br&gt;供應商 API、設備閘道、內部服務；處理規則以契約為準" style="rounded=1;whiteSpace=wrap;html=1;spacing=10;fontSize=15;fillColor=#f4faf8;strokeColor=#2d8a69;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="235" y="560" width="530" height="78" />
        </mxCell>
        <mxCell id="p4" value="" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;rounded=0;html=1;labelBackgroundColor=#ffffff;strokeColor=#536c82;" edge="1" parent="1" source="m3" target="m4">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="b0" value="&lt;b&gt;耐久狀態&lt;/b&gt;&lt;br&gt;Inbox／outbox、去重索引、結果與待對帳操作。" style="rounded=1;whiteSpace=wrap;html=1;spacing=10;fontSize=15;fillColor=#eff4f8;strokeColor=#4a6b85;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="160" y="740" width="330" height="100" />
        </mxCell>
        <mxCell id="d0" value="" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;rounded=0;html=1;labelBackgroundColor=#ffffff;strokeColor=#536c82;dashed=1;exitX=0;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="m1" target="b0">
          <mxGeometry as="geometry" relative="1">
            <Array as="points">
              <mxPoint x="120" y="254" />
              <mxPoint x="120" y="702" />
              <mxPoint x="325" y="702" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="b1" value="&lt;b&gt;證據與告警&lt;/b&gt;&lt;br&gt;結構化事件、Trace、各階段延遲；不記機密。" style="rounded=1;whiteSpace=wrap;html=1;spacing=10;fontSize=15;fillColor=#eff4f8;strokeColor=#4a6b85;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="510" y="740" width="330" height="100" />
        </mxCell>
        <mxCell id="d1" value="" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;rounded=0;html=1;labelBackgroundColor=#ffffff;strokeColor=#536c82;dashed=1;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="m2" target="b1">
          <mxGeometry as="geometry" relative="1">
            <Array as="points">
              <mxPoint x="890" y="369" />
              <mxPoint x="890" y="790" />
            </Array>
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="flow" name="流程：呼叫、重試與對帳">
    <mxGraphModel page="1" pageWidth="1000" pageHeight="930" grid="1">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;b&gt;流程：呼叫、重試與對帳&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;spacing=10;fontSize=15;fillColor=#dcebf5;strokeColor=#4a6b85;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="200" y="20" width="600" height="54" />
        </mxCell>
        <mxCell id="m0" value="&lt;b&gt;01 · 收件與分類&lt;/b&gt;&lt;br&gt;確定讀或寫、契約及操作 ID，開始總期限。" style="rounded=1;whiteSpace=wrap;html=1;spacing=10;fontSize=15;fillColor=#f4faf8;strokeColor=#2d8a69;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="235" y="100" width="530" height="78" />
        </mxCell>
        <mxCell id="m1" value="&lt;b&gt;02 · 入場保護&lt;/b&gt;&lt;br&gt;檢查截止、佇列、速率、並行數及斷路狀態。無法入場就回報。" style="rounded=1;whiteSpace=wrap;html=1;spacing=10;fontSize=15;fillColor=#f4faf8;strokeColor=#2d8a69;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="235" y="215" width="530" height="78" />
        </mxCell>
        <mxCell id="p1" value="" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;rounded=0;html=1;labelBackgroundColor=#ffffff;strokeColor=#536c82;" edge="1" parent="1" source="m0" target="m1">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="m2" value="&lt;b&gt;03 · 單次呼叫&lt;/b&gt;&lt;br&gt;剪裁單次預算；只發送一次，記錄送達證據。" style="rounded=1;whiteSpace=wrap;html=1;spacing=10;fontSize=15;fillColor=#f4faf8;strokeColor=#2d8a69;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="235" y="330" width="530" height="78" />
        </mxCell>
        <mxCell id="p2" value="" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;rounded=0;html=1;labelBackgroundColor=#ffffff;strokeColor=#536c82;" edge="1" parent="1" source="m1" target="m2">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="m3" value="&lt;b&gt;04 · 分類結果&lt;/b&gt;&lt;br&gt;依傳輸、HTTP 或 RPC、schema 與業務狀態分流。" style="rounded=1;whiteSpace=wrap;html=1;spacing=10;fontSize=15;fillColor=#f4faf8;strokeColor=#2d8a69;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="235" y="445" width="530" height="78" />
        </mxCell>
        <mxCell id="p3" value="" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;rounded=0;html=1;labelBackgroundColor=#ffffff;strokeColor=#536c82;" edge="1" parent="1" source="m2" target="m3">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="b0" value="&lt;b&gt;有效回應&lt;/b&gt;&lt;br&gt;驗證並落地後回成功；202 按契約轉作業查詢。" style="rounded=1;whiteSpace=wrap;html=1;spacing=10;fontSize=15;fillColor=#fff5db;strokeColor=#a97525;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="660" width="215" height="105" />
        </mxCell>
        <mxCell id="d0" value="" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;rounded=0;html=1;labelBackgroundColor=#ffffff;strokeColor=#536c82;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="m3" target="b0">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="b1" value="&lt;b&gt;暫時錯誤且可安全重試&lt;/b&gt;&lt;br&gt;算剩餘預算與退避；可重試則回入場保護，不足便結束。" style="rounded=1;whiteSpace=wrap;html=1;spacing=10;fontSize=15;fillColor=#fff5db;strokeColor=#a97525;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="265" y="660" width="215" height="105" />
        </mxCell>
        <mxCell id="d1" value="" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;rounded=0;html=1;labelBackgroundColor=#ffffff;strokeColor=#536c82;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="m3" target="b1">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="b2" value="&lt;b&gt;寫入結果不明&lt;/b&gt;&lt;br&gt;保存 UNKNOWN，以同一操作 ID 查詢／對帳；不盲目重送。" style="rounded=1;whiteSpace=wrap;html=1;spacing=10;fontSize=15;fillColor=#fff5db;strokeColor=#a97525;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="500" y="660" width="215" height="105" />
        </mxCell>
        <mxCell id="d2" value="" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;rounded=0;html=1;labelBackgroundColor=#ffffff;strokeColor=#536c82;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="m3" target="b2">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="b3" value="&lt;b&gt;永久拒絕或契約錯誤&lt;/b&gt;&lt;br&gt;不做一般重試；保留分類與證據，不覆寫已驗證快照。" style="rounded=1;whiteSpace=wrap;html=1;spacing=10;fontSize=15;fillColor=#fff5db;strokeColor=#a97525;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="735" y="660" width="215" height="105" />
        </mxCell>
        <mxCell id="d3" value="" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;rounded=0;html=1;labelBackgroundColor=#ffffff;strokeColor=#536c82;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="m3" target="b3">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="return" value="可重試則重新入場" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;rounded=0;html=1;labelBackgroundColor=#ffffff;strokeColor=#536c82;dashed=1;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="b1" target="m1">
          <mxGeometry as="geometry" relative="1">
            <Array as="points">
              <mxPoint x="372" y="820" />
              <mxPoint x="20" y="820" />
              <mxPoint x="20" y="254" />
            </Array>
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>