        <mxCell id="head" value="&lt;b&gt;工業資料採集 Gateway｜防火牆分區與連線發起方向&lt;/b&gt;" parent="1" vertex="1" style="html=1;whiteSpace=wrap;rounded=1;fillColor=#eaf5ef;strokeColor=#8ab59f;fontColor=#172b40;fontSize=23;spacing=8;">
