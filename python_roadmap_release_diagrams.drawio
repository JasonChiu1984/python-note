        <mxCell id="e2" parent="1" edge="1" source="n2" target="n3" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;strokeColor=#285e90;">
          <mxGeometry relative="1" as="geometry" />
