        <mxCell id="n1" parent="1" vertex="1" value="目標條件｜直譯器、OS、架構、ABI、extras" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#5883ad;fontSize=14;spacing=9;">
