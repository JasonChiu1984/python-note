<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net" type="device">
  <diagram id="architecture" name="A｜系統資料流">
    <mxGraphModel dx="1340" dy="380" page="1" pageWidth="1340" pageHeight="380" grid="1" tooltips="1" connect="1" arrows="1">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Python 與網頁前端｜系統資料流" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#163750;fontSize=25;fontStyle=1;spacing=6;" parent="1" vertex="1">
          <mxGeometry x="42" y="34" width="1200" height="42" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="讀取 → 驗證 → 交付 → 解析 → 呈現｜資料時間、品質及序號一路保留" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#365971;fontSize=15;whiteSpace=wrap;" parent="1" vertex="1">
          <mxGeometry x="45" y="89" width="1200" height="37" as="geometry" />
        </mxCell>
        <mxCell id="s0" value="01  資料來源&#10;&#10;PLC／感測器、資料庫或外部 API" style="rounded=1;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=10;fontColor=#163750;fontSize=15;strokeColor=#8db6c6;fillColor=#eff7fb;" parent="1" vertex="1">
          <mxGeometry x="42" y="154" width="220" height="126" as="geometry" />
        </mxCell>
        <mxCell id="s1" value="02  Python 採集與服務層&#10;&#10;讀取、驗證、正規化、建立快照" style="rounded=1;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=10;fontColor=#163750;fontSize=15;strokeColor=#8db6c6;fillColor=#eff7fb;" parent="1" vertex="1">
          <mxGeometry x="297" y="154" width="220" height="126" as="geometry" />
        </mxCell>
        <mxCell id="a1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#125f6c;strokeWidth=2;fontColor=#163750;fontSize=13;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" parent="1" source="s0" target="s1" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="03  Python Web API&#10;&#10;HTTP 快照、SSE 事件、WebSocket 訊息" style="rounded=1;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=10;fontColor=#163750;fontSize=15;strokeColor=#8db6c6;fillColor=#eff7fb;" parent="1" vertex="1">
          <mxGeometry x="552" y="154" width="220" height="126" as="geometry" />
        </mxCell>
        <mxCell id="a2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#125f6c;strokeWidth=2;fontColor=#163750;fontSize=13;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" parent="1" source="s1" target="s2" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="04  瀏覽器資料層&#10;&#10;Fetch、EventSource 或 WebSocket" style="rounded=1;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=10;fontColor=#163750;fontSize=15;strokeColor=#8db6c6;fillColor=#eff7fb;" parent="1" vertex="1">
          <mxGeometry x="807" y="154" width="220" height="126" as="geometry" />
        </mxCell>
        <mxCell id="a3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#125f6c;strokeWidth=2;fontColor=#163750;fontSize=13;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" parent="1" source="s2" target="s3" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s4" value="05  畫面與操作&#10;&#10;狀態卡、趨勢圖、告警與操作介面" style="rounded=1;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=10;fontColor=#163750;fontSize=15;strokeColor=#8db6c6;fillColor=#eff7fb;" parent="1" vertex="1">
          <mxGeometry x="1062" y="154" width="220" height="126" as="geometry" />
        </mxCell>
        <mxCell id="a4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#125f6c;strokeWidth=2;fontColor=#163750;fontSize=13;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" parent="1" source="s3" target="s4" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="foot" value="工控邊界：瀏覽器不直接連 PLC；透過受控 Python API 交付資料。" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#365971;fontSize=15;whiteSpace=wrap;" parent="1" vertex="1">
          <mxGeometry x="43" y="307" width="1260" height="42" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="transport" name="B｜三種連線方向">
    <mxGraphModel dx="1120" dy="1040" page="1" pageWidth="1120" pageHeight="1040" grid="1" tooltips="1" connect="1" arrows="1">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
