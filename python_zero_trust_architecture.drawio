<mxfile host="app.diagrams.net" version="24.7.8"><diagram id="architecture" name="架構與平面"><mxGraphModel grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1140" pageHeight="640"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="control-label" value="控制平面（虛線）" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dff3ee;strokeColor=#6f9ab7;fontSize=16;spacing=10;align=center;"><mxGeometry x="45" y="40" width="200" height="48" as="geometry" /></mxCell><mxCell id="signals" value="身分與脈絡&#10;身分服務、裝置狀態、工作負載識別與資源標籤供決策。" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dff3ee;strokeColor=#6f9ab7;fontSize=16;spacing=10;align=center;"><mxGeometry x="55" y="113" width="240" height="112" as="geometry" /></mxCell><mxCell id="pe" value="PE 政策引擎&#10;對主體、目標、動作與風險條件判斷允許、拒絕或終止。" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dff3ee;strokeColor=#6f9ab7;fontSize=16;spacing=10;align=center;"><mxGeometry x="360" y="113" width="240" height="112" as="geometry" /></mxCell><mxCell id="pa" value="PA 政策管理元件&#10;依 PE 決策協調建立或終止通道，向 PEP 傳達控制指令。" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dff3ee;strokeColor=#6f9ab7;fontSize=16;spacing=10;align=center;"><mxGeometry x="665" y="113" width="240" height="112" as="geometry" /></mxCell><mxCell id="data-label" value="資料平面（實線）" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8f3ff;strokeColor=#6f9ab7;fontSize=16;spacing=10;align=center;"><mxGeometry x="45" y="303" width="200" height="48" as="geometry" /></mxCell><mxCell id="subject" value="主體" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8f3ff;strokeColor=#6f9ab7;fontSize=16;spacing=10;align=center;"><mxGeometry x="55" y="415" width="205" height="75" as="geometry" /></mxCell><mxCell id="pep" value="PEP 政策執行點" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8f3ff;strokeColor=#6f9ab7;fontSize=16;spacing=10;align=center;"><mxGeometry x="425" y="415" width="205" height="75" as="geometry" /></mxCell><mxCell id="resource" value="資源" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8f3ff;strokeColor=#6f9ab7;fontSize=16;spacing=10;align=center;"><mxGeometry x="795" y="415" width="205" height="75" as="geometry" /></mxCell><mxCell id="a0" edge="1" parent="1" source="signals" target="pe" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;strokeColor=#397a73;strokeWidth=2;dashed=1;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="a1" edge="1" parent="1" source="pe" target="pa" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;strokeColor=#397a73;strokeWidth=2;dashed=1;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="a2" edge="1" parent="1" source="pa" target="pep" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;strokeColor=#397a73;strokeWidth=2;dashed=1;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="a3" edge="1" parent="1" source="subject" target="pep" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;strokeColor=#376689;strokeWidth=2;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="a4" edge="1" parent="1" source="pep" target="resource" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;strokeColor=#376689;strokeWidth=2;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="pdp" value="PDP：PE ＋ PA（邏輯職責）" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dff3ee;strokeColor=#6f9ab7;fontSize=16;spacing=10;align=center;"><mxGeometry x="365" y="40" width="535" height="48" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="flow" name="授權與撤銷流程"><mxGraphModel grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1140" pageHeight="640"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="step0" value="提出請求&#10;由受管裝置或工作負載要求特定資源和動作。" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8f3ff;strokeColor=#6f9ab7;fontSize=16;spacing=10;align=center;"><mxGeometry x="58" y="140" width="174" height="145" as="geometry" /></mxCell><mxCell id="step1" value="取得可信訊號&#10;驗證身分與裝置／工作負載證據，核對資源與情境。" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8f3ff;strokeColor=#6f9ab7;fontSize=16;spacing=10;align=center;"><mxGeometry x="265" y="140" width="174" height="145" as="geometry" /></mxCell><mxCell id="e1" edge="1" parent="1" source="step0" target="step1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;strokeColor=#376689;strokeWidth=2;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="step2" value="判定與執行&#10;PE 作決策，PA 協調由 PEP 建立、限制或拒絕通道。" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8f3ff;strokeColor=#6f9ab7;fontSize=16;spacing=10;align=center;"><mxGeometry x="472" y="140" width="174" height="145" as="geometry" /></mxCell><mxCell id="e2" edge="1" parent="1" source="step1" target="step2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;strokeColor=#376689;strokeWidth=2;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="step3" value="持續評估&#10;收到撤銷、姿態過期或風險變動，重新判斷並執行回收。" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8f3ff;strokeColor=#6f9ab7;fontSize=16;spacing=10;align=center;"><mxGeometry x="679" y="140" width="174" height="145" as="geometry" /></mxCell><mxCell id="e3" edge="1" parent="1" source="step2" target="step3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;strokeColor=#376689;strokeWidth=2;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="step4" value="記錄與驗收&#10;記錄決策理由、政策版本與時鐘，查有效回收與本地持續運轉。" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8f3ff;strokeColor=#6f9ab7;fontSize=16;spacing=10;align=center;"><mxGeometry x="886" y="140" width="174" height="145" as="geometry" /></mxCell><mxCell id="e4" edge="1" parent="1" source="step3" target="step4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;strokeColor=#376689;strokeWidth=2;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="note" value="不符合、超過時效或決策依賴故障：遠端不預設放行；依核准策略收回。" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffefd7;strokeColor=#6f9ab7;fontSize=16;spacing=10;align=center;"><mxGeometry x="85" y="390" width="970" height="65" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>